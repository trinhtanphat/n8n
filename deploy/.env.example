# ============================================
# n8n VNSO - Environment Configuration Example
# Copy this file to .env and fill in real values
# ============================================

# --- Database ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- n8n General ---
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# --- Security ---
N8N_SECURE_COOKIE=true
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Turnstile (optional) ---
N8N_PUBLIC_SIGNUP_TURNSTILE_SITE_KEY=
N8N_PUBLIC_SIGNUP_TURNSTILE_SECRET_KEY=

# --- Social Login (optional) ---
N8N_SOCIAL_LOGIN_GOOGLE_ENABLED=false
N8N_SOCIAL_LOGIN_GOOGLE_CLIENT_ID=
N8N_SOCIAL_LOGIN_GOOGLE_CLIENT_SECRET=
N8N_SOCIAL_LOGIN_GITHUB_ENABLED=false
N8N_SOCIAL_LOGIN_GITHUB_CLIENT_ID=
N8N_SOCIAL_LOGIN_GITHUB_CLIENT_SECRET=
